{
  "name": "jarvis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "node scripts/make-icons.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "icons:android": "npm run icons && npx @capacitor/assets generate --android --iconBackgroundColor '#060a2a' --splashBackgroundColor '#060a2a' && node scripts/compress-splash.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
